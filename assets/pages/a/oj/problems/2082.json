  "sample_output": "3 2",
  "hidden_tests": [
    {
      "input": "1 0 1 1",
      "expected_output": "0 1"
    },
    {
      "input": "3 1 3 1\n1 3",
      "expected_output": "-1 0"
    },
    {
      "input": "4 4 4 2\n4 3\n3 1\n1 2\n4 2",
      "expected_output": "3 1"
