  "description": "可以从两封电报中各删除一些字符，剩余字符的相对顺序保持不变。求两封电报能保留的最长相同内容的长度。",
  "input_format": "两行各一个小写英文串，长度 1 至 1000。",
  "output_format": "输出最长长度。",
  "sample_input": "abdcab\nbadba",
  "sample_output": "3",
  "hidden_tests": [
    {
      "input": "a\nb",
      "expected_output": "0"
    },
    {
      "input": "a\na",
      "expected_output": "1"
    },
    {
      "input": "aaaa\naa",
      "expected_output": "2"
    },
    {
      "input": "abc\ncba",
      "expected_output": "1"
    },
    {
      "input": "\",
      "expected_output": "999"
    }
  ]
