  "time_limit": "1500ms",
  "memory_limit": "128MB",
  "description": "工作有前置依赖。每一步从前置工作都已完成的工作中选编号最小的一项。求完整执行序列，若无法完成全部则报告环。",
  "input_format": "首行 n、m（1 ≤ n ≤ 50000，0 ≤ m ≤ 100000）。随后 m 行 u、v 表示必须先完成 u 后完成 v，编号为 1 至 n。",
  "output_format": "输出空格分隔的执行序列，无法完成则只输出 CYCLE。",
  "sample_input": "5 3\n4 2\n1 3\n3 2",
  "sample_output": "1 3 4 2 5",
  "hidden_tests": [
    {
      "input": "1 1\n1 1",
      "expected_output": "CYCLE"
    },
    {
      "input": "3 0",
      "expected_output": "1 2 3"
    },
    {
      "input": "4 3\n1 2\n2 3\n3 2",
      "expected_output": "CYCLE"
    },
    {
      "input": "3 3\n1 2\n1 2\n2 3",
      "expected_output": "1 2 3"
    }
  ]
}
