  "input_format": "两行，每行一个含 1 至 500 个十进制数字的整数，首字符允许是 + 或 -。",
  "output_format": "按第一数相对于第二数的大小输出 <、= 或 >。",
  "sample_input": "-00067\n-000060",
  "sample_output": "<",
  "hidden_tests": [
    {
