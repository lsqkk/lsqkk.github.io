      "expected_output": "1 4"
    },
    {
      "input": "20\nRRR",
      "expected_output": "4 0"
    },
    {
      "input": "2\nLRLR",
      "expected_output": "2 1"
    },
    {
      "input": "1000000000\nRRRR",
      "expected_output": "5 0"
