  "sample_output": "2",
  "hidden_tests": [
    {
      "input": "1 1 0",
      "expected_output": "0"
    },
    {
      "input": "5 10 10",
      "expected_output": "1"
    },
    {
      "input": "999983 999979 1000000000000000",
      "expected_output": "1000"
    },
    {
      "input": "10 20 19",
      "expected_output": "0"
    }
