{
  "id": 2014,
  "track": "arrays",
  "difficulty": "简单",
  "title": "会合位置旋转",
  "tags": [
    "字符串",
    "循环数组"
  ],
  "time_limit": "1500ms",
  "memory_limit": "128MB",
  "description": "显示屏有 n 个位置，依次记录一个字符。每次右旋可以将最后一个字符移至最前，其余字符向右挪一格。求把初始状态旋转成目标状态所需的最少次数。",
  "input_format": "两行等长的非空小写英文串，每串长度不超过 50000。",
  "output_format": "输出最少的右旋次数，无法达到时输出 -1。",
  "sample_input": "bcabca\nabcabc",
  "sample_output": "1",
  "hidden_tests": [
    {
      "input": "aaa\naaa",
      "expected_output": "0"
    },
    {
      "input": "asdf\nasdg",
      "expected_output": "-1"
    },
    {
      "input": "abcd\nbcda",
      "expected_output": "3"
    },
    {
      "input": "ababa\nbaaba",
      "expected_output": "2"
    },
    {
      "input": "\",
      "expected_output": "1"
    }
  ]
}
