  "sample_output": "8",
  "hidden_tests": [
    {
      "input": "1 2\nSE",
      "expected_output": "1"
    },
    {
      "input": "1 3\nSDE",
      "expected_output": "-1"
    },
    {
      "input": "3 3\nS#E\n.#.\nKDD",
      "expected_output": "6"
    },
    {
      "input": "3 3\nS..\n##D\nKE.",
      "expected_output": "-1"
    }
