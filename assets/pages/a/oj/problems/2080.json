  "sample_input": "5 5\n1 2\n2 3\n3 1\n3 4\n4 5",
  "sample_output": "2",
  "hidden_tests": [
    {
      "input": "5 0",
      "expected_output": "0"
    },
    {
      "input": "2 2\n1 2\n1 2",
      "expected_output": "0"
    },
    {
      "input": "5 3\n1 2\n2 3\n4 5",
      "expected_output": "3"
    },
    {
      "input": "4 4\n1 2\n2 3\n3 4\n4 1",
      "expected_output": "0"
    }
  ]
