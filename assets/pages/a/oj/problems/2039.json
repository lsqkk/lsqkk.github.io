{
  "id": 2039,
  "track": "sorting",
  "difficulty": "简单",
  "title": "压缩楼层号",
  "tags": [
    "离散化",
    "排序"
  ],
  "time_limit": "1500ms",
  "memory_limit": "128MB",
  "description": "将所有出现过的楼层按楼层号从小到大重新编号为 1、2、3、……。相同楼层的新编号必须相同。保持输入顺序输出新编号。",
  "input_format": "第一行 n（1 至 100000）。第二行 n 个整数楼层号，绝对值不超过 10^9。",
  "output_format": "在一行用空格输出 n 个新编号。",
  "sample_input": "5\n80 -1 80 6 -1",
  "sample_output": "3 1 3 2 1",
  "hidden_tests": [
    {
      "input": "1\n999",
      "expected_output": "1"
    },
    {
      "input": "4\n0 0 0 0",
      "expected_output": "1 1 1 1"
    },
    {
      "input": "4\n100 -100 -50 200",
      "expected_output": "3 1 2 4"
    },
    {
      "input": "5\n1000000000 0 -1000000000 1 0",
      "expected_output": "4 2 1 3 2"
    }
  ]
}
