  "title": "旋转后的左右判定",
  "tags": [
    "叉积",
    "点",
    "64 位整数"
  ],
  "time_limit": "1500ms",
  "memory_limit": "128MB",
  "description": "给定有向线段 A→B，判断点 C 位于直线的左侧、右侧还是直线上。横坐标向右、纵坐标向上。",
  "input_format": "第一行 q（1 至 10000）。随后 q 行六个整数 ax、ay、bx、by、cx、cy，绝对值不超过 10^9，A 与 B 不重合。",
  "output_format": "每行输出 LEFT、RIGHT 或 LINE。",
  "sample_input": "3\n0 0 4 0 3 1\n0 0 4 0 -1 -2\n0 0 4 0 8 0",
  "sample_output": "LEFT\nRIGHT\nLINE",
  "hidden_tests": [
    {
      "input": "1\n0 0 1 1 0 0",
      "expected_output": "LINE"
    },
    {
      "input": "1\n0 0 1 -1 -3 3",
      "expected_output": "LINE"
    },
    {
      "input": "2\n-1000000000 -1000000000 1000000000 1000000000 999999999 1000000000\n0 1 0 -1 1 0",
      "expected_output": "LEFT\nLEFT"
    },
    {
      "input": "1\n0 0 999999999 1000000000 999999998 999999999",
      "expected_output": "LEFT"
    }
  ]
}
