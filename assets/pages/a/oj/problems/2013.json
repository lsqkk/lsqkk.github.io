{
  "id": 2013,
  "track": "arrays",
  "difficulty": "简单",
  "title": "矩阵的鞍点",
  "tags": [
    "二维数组",
    "最值"
  ],
  "time_limit": "1500ms",
  "memory_limit": "128MB",
  "description": "矩阵中同时等于所在行最小值和所在列最大值的位置叫鞍点。相同的数字可以出现在多个鞍点中。",
  "input_format": "第一行 n、m（1 ≤ n,m ≤ 200）。接下来 n 行每行 m 个整数，绝对值不超过 10^9。",
  "output_format": "输出鞍点数量。",
  "sample_input": "2 3\n5 4 6\n2 3 9",
  "sample_output": "1",
  "hidden_tests": [
    {
      "input": "1 1\n-5",
      "expected_output": "1"
    },
    {
      "input": "2 2\n1 2\n2 1",
      "expected_output": "0"
    },
    {
      "input": "2 3\n0 0 0\n0 0 0",
      "expected_output": "6"
    },
    {
      "input": "3 1\n-9\n-1\n-1",
      "expected_output": "2"
    }
  ]
}
