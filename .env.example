# Reference for Vercel server-side environment variables.
# Copy only the groups needed by enabled features. Never commit real values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM=
EMAIL_TOKEN_SECRET=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional private bucket for QuarkShare; use a different bucket from R2_BUCKET.
R2_SHARE_BUCKET=
# Optional coturn relay in TURN REST shared-secret mode.
SHARE_TURN_URLS=
SHARE_TURN_SECRET=

# Browser-readable mappings exposed by /api/keys, only when a page needs them.
TIANDITU_KEY=
GITHUB_API_KEY=
# Compatibility mapping; no current weather directory page.
OPENWEATHER_API_KEY=

# Managed chat encryption/signing and Vercel scheduled cleanup
CHAT_ROOM_SECRET=
CRON_SECRET=
