[Unit]
Description=Quark Live media server
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
LoadCredential=mediamtx.yml:/etc/quark-live/mediamtx.yml
ExecStart=/opt/quark-live/mediamtx ${CREDENTIALS_DIRECTORY}/mediamtx.yml
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
