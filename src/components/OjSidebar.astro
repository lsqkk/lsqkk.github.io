---
interface Props {
  active: "home" | "train" | "list" | "discussion" | "record";
}
const { active } = Astro.props;
const items = [
  ["home", "/a/oj", "总览"],
  ["list", "/a/oj/problem-list", "题库"],
  ["train", "/a/oj/train", "练习"],
  ["record", "/a/oj/submission-record", "提交记录"],
  ["discussion", "/a/oj/discussion", "讨论区"],
];
---
<header class="oj-header">
  <div class="oj-header-inner">
    <a href="/a/oj" class="oj-brand"><span aria-hidden="true">&gt;_</span> Quark<span class="oj-brand-end">OJ</span></a>
    <nav aria-label="QuarkOJ 导航">
      {items.map(([key, href, label]) => <a href={href} aria-current={active === key ? "page" : undefined}>{label}</a>)}
    </nav>
    <a class="oj-site-link" href="/a">实验室 ↗</a>
  </div>
</header>
