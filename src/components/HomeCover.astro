<section class="quark-cover" data-quark-cover data-nav-after aria-labelledby="quark-cover-title">
  <div class="cover-stage">
    {["sharp", "soft"].map(layer => {
      const Heading = layer === "sharp" ? "h1" : "p";
      return (
        <div class:list={["cover-scene", `cover-scene-${layer}`]} aria-hidden={layer === "soft" ? "true" : undefined}>
          <canvas aria-hidden="true"></canvas>
          <div class="cover-identity">
            <p class="cover-wordmark" lang="en">Strange Quark</p>
            <Heading class="cover-title" id={layer === "sharp" ? "quark-cover-title" : undefined}>奇夸克</Heading>
            <p class="cover-caption">技术 · 生活 · 思考</p>
          </div>
        </div>
      );
    })}
    <div class="cover-actions">
      <nav class="cover-links" aria-label="首页快捷入口">
        <a href="/posts/">文章</a>
        <a href="/tool/">工具</a>
        <a href="/blog/project/">项目</a>
      </nav>
      <a class="cover-next" href="#home-content" aria-label="向下进入首页内容">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .quark-cover {
    --cover-paper: #f7f9fd;
    --cover-ink: #192842;
    --cover-muted: #465673;
    --cover-edge: #cfd9e8;
    --cover-surface: #ffffffa8;
    --cover-glow: #dde8fb;
    --cover-glow-secondary: #e1f1f3;
    position: relative;
    min-block-size: 100vh;
    min-block-size: 100svh;
    /* Clip the viewport-fixed stage at the leading edge of the homepage. */
    clip-path: inset(0);
    color: var(--cover-ink);
  }

  .cover-stage {
    position: fixed;
    inset: 0 0 auto;
    block-size: 100vh;
    block-size: 100svh;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 84% 14%, var(--cover-glow-secondary), transparent 54%),
      radial-gradient(ellipse at 14% 88%, var(--cover-glow), transparent 57%),
      var(--cover-paper);
  }

  :global(body.dark-mode) .quark-cover {
    --cover-paper: #0d1626;
    --cover-ink: #eaf2ff;
    --cover-muted: #b0c3dd;
    --cover-edge: #415675;
    --cover-surface: #17253cd9;
    --cover-glow: #182c4e;
    --cover-glow-secondary: #102d37;
  }

  canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: linear-gradient(transparent 2%, #000 20%, #000 80%, transparent 98%);
  }

  .cover-identity {
    display: grid;
    justify-items: center;
    gap: clamp(8px, 2.15vh, 21px);
    padding: 0 16px;
    text-align: center;
  }

  .cover-wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--cover-muted);
    font-family: system-ui, sans-serif;
    font-size: clamp(10px, 1.4vw, 12px);
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .cover-wordmark::before, .cover-wordmark::after {
    content: "";
    inline-size: clamp(14px, 3vw, 30px);
    block-size: 1px;
    background: var(--cover-edge);
  }

  .cover-caption {
    color: var(--cover-muted);
    font-size: clamp(13px, 1.55vw, 16px);
    letter-spacing: .13em;
  }

  .cover-title {
    font-size: clamp(3.75rem, 11vw, 9rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding-inline-start: 0.1em;
    white-space: nowrap;
  }

  .cover-actions {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    inset-block-end: max(22px, env(safe-area-inset-bottom));
    display: grid;
    justify-items: center;
    gap: 12px;
  }

  .cover-links {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--cover-edge);
    border-radius: 999px;
    background: var(--cover-surface);
  }

  .cover-links a, .cover-next {
    display: grid;
    place-items: center;
    color: var(--cover-muted);
    text-decoration: none;
    border-radius: 999px;
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .cover-links a {
    min-block-size: 34px;
    padding-inline: 14px;
    font-size: 13px;
  }

  .cover-next {
    inline-size: 46px;
    block-size: 46px;
    border: 1px solid var(--cover-edge);
    background: var(--cover-surface);
  }

  .cover-links a:hover, .cover-next:hover {
    color: var(--cover-ink);
    background: var(--cover-glow);
  }

  .cover-next:hover { transform: translateY(2px); }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .cover-scene {
    position: absolute;
    inset: 0;
    isolation: isolate;
    display: grid;
    place-items: center;
  }

  .cover-scene-soft {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .cover-scene-soft .cover-identity {
    filter: blur(clamp(3.5px, .48vw, 7px));
  }

  @supports (animation-timeline: view()) and (animation-range: exit) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-motion="reduce"])) .quark-cover {
        view-timeline-name: --quark-cover-exit;
      }

      :global(html:not([data-motion="reduce"])) .cover-scene {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --quark-cover-exit;
        animation-range: exit 0% exit 48%;
      }

      .cover-scene-sharp { animation-name: quark-cover-sharp; }
      .cover-scene-soft { animation-name: quark-cover-soft; }
    }
  }

  @keyframes quark-cover-sharp {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes quark-cover-soft {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  :global(html[data-motion="reduce"]) .cover-stage {
    position: absolute;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-stage { position: absolute; }
  }

  @media (max-height: 420px) {
    .quark-cover { min-block-size: max(300px, 100svh); }
    .cover-stage { block-size: max(300px, 100svh); }
    .cover-identity { gap: 5px; }
    .cover-title { font-size: clamp(2.5rem, 14svh, 4.5rem); }
    .cover-actions { gap: 4px; inset-block-end: 10px; }
  }
</style>

<script>
  import { animateCover } from "../scripts/home-cover";

  const cover = document.querySelector<HTMLElement>("[data-quark-cover]");
  const canvas = cover?.querySelector<HTMLCanvasElement>(".cover-scene-sharp canvas");
  if (cover && canvas) animateCover(cover, canvas);
</script>
