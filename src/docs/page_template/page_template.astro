---
import LuxuryBackground from "../../components/LuxuryBackground.astro";
import navConfig from "../../config/json/nav.json";
import {SITE_TITLE, SITE_LOGO_URL, SITE_URL} from "@siteConfig";
// This file is a source template, outside src/pages. Adjust relative imports after copying.
const pageName = "页面名称";
const description = "用一句话说明页面解决什么问题。";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageName} - {SITE_TITLE}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, SITE_URL)} />
  <link rel="icon" href={SITE_LOGO_URL} />
  <link rel="stylesheet" href="/assets/css/basic.css" />
  <link rel="stylesheet" href="/assets/css/nav.css" />
  <script is:inline define:vars={{navConfig}}>window.__NAV_CONFIG__ = navConfig;</script>
  <script is:inline defer src="/assets/js/nav.js"></script>
</head>
<body class="luxury-body">
  <LuxuryBackground />
  <main class="example-shell">
    <header><h1>{pageName}</h1><p>{description}</p></header>
    <section aria-labelledby="example-title">
      <h2 id="example-title">主要内容</h2>
      <p>在这里实现页面任务；链接使用真实地址，交互提供结果与失败反馈。</p>
    </section>
    <footer><a href="/">{SITE_TITLE}</a> · <a href="/posts/copyright">关于本站</a></footer>
  </main>
</body>
</html>
<style>
  .example-shell { max-width:1100px; margin:auto; padding:110px var(--page-gutter,24px) 40px; color:var(--text-main); }
  .example-shell header { margin-bottom:36px; }
  .example-shell h1 { font-size:clamp(28px,5vw,48px); }
  .example-shell p { color:var(--text-subtle); line-height:1.8; }
  .example-shell section { border-top:1px solid var(--line); padding-top:24px; }
  .example-shell footer { border-top:1px solid var(--line); margin-top:48px; padding-top:20px; font-size:12px; }
</style>
