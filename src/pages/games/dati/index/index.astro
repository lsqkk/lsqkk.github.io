---
import RealtimeRoomLayout from "../../../../layouts/RealtimeRoomLayout.astro";
import { SITE_TITLE } from "@siteConfig";
---
<RealtimeRoomLayout
  pageTitle={`知识擂台 - ${SITE_TITLE}`}
  bodyClass="dark-mode quiz-arena"
  pageStyles={["/assets/css/room.css", "/assets/pages/games/dati/dati.css"]}
  headScripts={[
    "https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js",
    "https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js",
  ]}
  tailScripts={[
    "__API_BASE__/api/firebase-config?v=1",
    "/assets/pages/games/dati/dati.js",
  ]}
>
  <div class="app-container">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-title">最近擂台</div>
        <button type="button" class="arena-control" id="themeToggle" aria-pressed="false">亮色</button>
      </div>
      <div class="room-list" id="roomList"></div>
    </aside>

    <main class="main-content">
      <header class="game-header">
        <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="最近擂台"><i class="fas fa-bars" aria-hidden="true"></i></button>
        <div class="game-title" id="currentRoomTitle">知识擂台</div>
        <button type="button" class="arena-control" id="backToLobby" hidden>返回大厅</button>
        <a href="/games/" class="room-back">游戏大厅 ↗</a>
      </header>

      <div class="game-container">
        <section id="profileSetup" class="arena-lobby">
          <header class="arena-hero">
            <h1>知识擂台</h1>
            <p>挑一个题库练连对，或叫上朋友来场十秒抢答。</p>
          </header>
          <div class="arena-modes">
            <section class="arena-card">
              <h2><i class="fas fa-bolt" aria-hidden="true"></i> 单人闯关</h2>
              <p>不限时作答，打完一局可立即重练错题。</p>
              <label for="quizSource">题库</label>
              <select id="quizSource"><option value="">混合题库</option></select>
              <label for="quizCount">每局题数</label>
              <select id="quizCount"><option value="5">5 题 · 热身</option><option value="10">10 题 · 标准</option><option value="20">20 题 · 耐力</option></select>
              <button type="button" class="arena-primary" id="startSoloBtn">开始闯关</button>
            </section>
            <form id="joinForm" class="arena-card">
              <h2><i class="fas fa-gamepad" aria-hidden="true"></i> 双人对战</h2>
              <p>约定同一个房间号，分坐两个席位。先到 100 分获胜。</p>
              <label for="roomInput">房间号</label>
              <input id="roomInput" placeholder="例如 quark-9" maxlength="32" autocomplete="off" required />
              <label for="nicknameInput">对战昵称</label>
              <div class="arena-identity">
                <input id="nicknameInput" maxlength="24" placeholder="你的昵称" />
                <input id="colorPicker" type="color" aria-label="玩家颜色" value="#a4f3ce" />
              </div>
              <label for="battleRole">席位</label>
              <select id="battleRole"><option value="player1">玩家 1</option><option value="player2">玩家 2</option><option value="spectator">观战</option></select>
              <button class="arena-primary" id="joinRoomBtn">进入擂台</button>
            </form>
          </div>
          <p id="lobbyStatus" role="status"></p>
        </section>

        <section id="soloContent" class="arena-stage" hidden>
          <div class="arena-hud"><span id="soloCounter"></span><span id="soloStreak"></span></div>
          <progress id="soloProgress" aria-label="闯关进度" value="0" max="5"></progress>
          <div class="question-container arena-card">
            <h2 id="question" tabindex="-1"></h2>
            <div class="options" id="options"></div>
            <p id="resultMessage" class="result-message" role="status"></p>
            <div class="arena-actions">
              <button type="button" class="arena-primary" id="submitBtn" disabled>锁定答案</button>
              <button type="button" class="arena-control" id="reviewBtn" hidden>重练本局错题</button>
            </div>
          </div>
          <p id="stats"></p>
        </section>

        <section id="battleContent" class="arena-stage" hidden>
          <div class="players-info">
            <div class="player" id="player1">
              <div class="player-avatar">P1</div>
              <div><div class="player-name">等待玩家 1</div><div class="player-role">空席</div></div>
            </div>
            <strong>VS</strong>
            <div class="player" id="player2">
              <div class="player-avatar">P2</div>
              <div><div class="player-name">等待玩家 2</div><div class="player-role">空席</div></div>
            </div>
          </div>
          <div class="progress-container">
            <span class="score" id="score1">0</span>
            <div class="progress-bar"><div class="progress-fill" id="progress1"></div></div>
            <div class="progress-bar"><div class="progress-fill" id="progress2"></div></div>
            <span class="score" id="score2">0</span>
          </div>
          <div class="question-container arena-card">
            <div class="timer" id="timer" aria-label="剩余秒数">—</div>
            <h2 id="battleQuestion">等待双方入席</h2>
            <div class="options" id="battleOptions"></div>
            <p class="game-status" id="battleStatus" role="status"></p>
          </div>
          <button type="button" class="arena-control" id="restartBtn" hidden>再来一局</button>
        </section>
      </div>
    </main>
  </div>

  <div id="winnerOverlay" class="winner-overlay" hidden>
    <section class="arena-card winner-box" aria-labelledby="winnerName">
      <p>本局获胜</p>
      <h2 id="winnerName"></h2>
      <div class="arena-actions">
        <button type="button" class="arena-primary" id="overlayRestart">再来一局</button>
        <button type="button" class="arena-control" id="winnerClose">返回大厅</button>
      </div>
    </section>
  </div>
</RealtimeRoomLayout>
