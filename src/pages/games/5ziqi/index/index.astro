---
import RealtimeRoomLayout from "../../../../layouts/RealtimeRoomLayout.astro";
import { SITE_TITLE } from "@siteConfig";
---
<RealtimeRoomLayout
    pageTitle={`在线五子棋 - ${SITE_TITLE}`}
    bodyClass="gomoku-page"
    pageStyles={["/assets/pages/games/5ziqi/5ziqi.css"]}
    headScripts={[
        "https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js",
        "https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js",
    ]}
>
    <main id="gomoku">
        <header class="gm-header">
            <div><a href="/games/">‹ 游戏</a><h1>在线五子棋</h1></div>
            <p id="gm-connection" role="status">连接中…</p>
        </header>
        <div class="gm-layout">
            <aside class="gm-lobby" aria-labelledby="gm-lobby-title">
                <h2 id="gm-lobby-title">对局大厅</h2>
                <form id="gm-join">
                    <label for="gm-room">房间号</label>
                    <div class="gm-field">
                        <input id="gm-room" maxlength="24" placeholder="输入好友的房间号" required />
                        <button type="submit">进入</button>
                    </div>
                </form>
                <button id="gm-create" class="gm-primary" type="button">创建房间</button>
                <h3>最近对局</h3>
                <ul id="gm-history"></ul>
            </aside>
            <section class="gm-table" aria-labelledby="gm-title">
                <header class="gm-table-header">
                    <h2 id="gm-title">等待入座</h2>
                    <div class="gm-actions" id="gm-room-actions" hidden>
                        <button id="gm-invite" type="button">复制邀请</button>
                        <button id="gm-leave" type="button">退出</button>
                    </div>
                </header>
                <p id="gm-status" class="gm-status" role="status">创建房间，或输入好友分享的房间号。</p>
                <div class="gm-game">
                    <div class="gm-board-wrap">
                        <div id="gm-board" class="gm-board" role="group" aria-label="15 × 15 五子棋棋盘"></div>
                    </div>
                    <div id="gm-match" class="gm-match" hidden>
                        <label for="gm-nickname">对局昵称</label>
                        <input id="gm-nickname" placeholder="输入昵称后入座" maxlength="20" />
                        <div class="gm-seat"><span class="gm-stone black"></span><div><strong>黑方</strong><span id="gm-black">空位</span></div><button id="gm-join-black" type="button">执黑</button></div>
                        <div class="gm-seat"><span class="gm-stone white"></span><div><strong>白方</strong><span id="gm-white">空位</span></div><button id="gm-join-white" type="button">执白</button></div>
                        <div class="gm-actions">
                            <button id="gm-stand" type="button" hidden>转为观战</button>
                            <button id="gm-rematch" type="button" hidden>再来一局</button>
                        </div>
                        <p id="gm-moves"></p>
                    </div>
                </div>
                <p id="gm-message" class="gm-message" role="status" hidden></p>
            </section>
        </div>
    </main>
    <script is:inline src="__API_BASE__/api/firebase-config?v=1"></script>
    <script is:inline src="/assets/pages/games/5ziqi/room.js?v=2"></script>
</RealtimeRoomLayout>
