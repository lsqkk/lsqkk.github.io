---
import CatalogLayout from '../../../layouts/CatalogLayout.astro';
import data from '../../../../assets/pages/games/game.json';
const descriptions = {
  '5ziqi':'邀请朋友在线对弈，分享房间即可开始一盘五子棋。',
  'spy-signal':'四人组队交换暗号，在推理与监听中寻找线索。',
  'dati':'独自练习或与朋友对战，在知识问答中一较高下。',
  'xjtx':'观察真实校园照片，找出它在交大兴庆校区的位置。'
};
const groups = [
  {key:'multiplayer',name:'和朋友一起',description:'交流、推理、博弈。让一场游戏成为相聚的理由。',tag:'多人互动'},
  {key:'singlePlayer',name:'发现校园',description:'从一张照片出发，重新认识熟悉的角落。',tag:'校园原创'}
].map(group=>({...group,items:data[group.key].map(item=>({name:item.name,href:'/games/'+item.link,description:descriptions[item.link],tags:[group.tag]}))}));
---
<CatalogLayout title="游戏" eyebrow="QUARK / PLAY SOMETHING DIFFERENT" description="留下值得再玩一次的体验。原创推理、校园探索，与朋友一起完成的挑战。" groups={groups} kind="games" />
