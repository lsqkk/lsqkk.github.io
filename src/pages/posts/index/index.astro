---
import ReadingDeskEntry from "../../../components/ReadingDeskEntry.astro";
import LuxuryBackground from "../../../components/LuxuryBackground.astro";
import fs from "node:fs/promises";
import path from "node:path";

const PROJECT_ROOT = process.cwd();
const navConfigPath = path.join(PROJECT_ROOT, "src", "config", "json", "nav.json");
const postsPath = path.join(PROJECT_ROOT, "posts", "posts.json");

const navConfig = JSON.parse(await fs.readFile(navConfigPath, "utf8"));
const postsData = JSON.parse(await fs.readFile(postsPath, "utf8"));
import { SITE_TITLE, SITE_LOGO_URL, SITE_URL } from "@siteConfig";
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>文章 / POSTS - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} type="image/png" />
    <link rel="stylesheet" href="/assets/css/basic.css" />
    <link rel="stylesheet" href="/assets/css/cursor.css" />
    <link rel="stylesheet" href="/assets/css/posts.css" />
    <link rel="stylesheet" href="/assets/css/reading-desk.css" />
    <link rel="stylesheet" href="/assets/css/fa-local.css" />
    <script is:inline define:vars={{ navConfig, postsData }}>
      window.__NAV_CONFIG__ = navConfig;
      window.__POSTS_DATA__ = postsData;
    </script>
    <script is:inline src="/assets/js/cursor-trail.js"></script>
  </head>

  <body class="luxury-body posts-index-page">
    <LuxuryBackground />

    <script is:inline src="/assets/js/nav.js"></script>

    <div class="posts-container">
      <header class="posts-index-header"><div><p>QUARK / NOTES & IDEAS</p><h1 class="page-title">文章</h1></div><a href={SITE_URL + "/posts/rss.xml"} class="posts-rss"><i class="fa-solid fa-rss" aria-hidden="true"></i> 订阅 RSS ↗</a></header>
      <div class="posts-index-layout">
      <main class="posts-index-main" aria-label="文章列表">
      <div class="posts-list-status"><span id="postsListStatus" role="status">共 {postsData.length} 篇文章</span><button type="button" id="postsResetFilters" hidden>清除筛选 ×</button></div>
      <form class="posts-local-search" role="search" onsubmit="event.preventDefault(); searchBlog();">
        <input type="search" id="searchInput" aria-label="筛选文章" placeholder="筛选文章标题或标签" />
        <button type="submit">筛选</button>
      </form>
      <div id="searchResults" class="search-results"></div>
      <div id="posts"></div>
      <div class="pagination" id="pagination">
        <button class="page-btn prev-btn" onclick="prevPage()">上一页</button>
        <div class="page-numbers" id="pageNumbers"></div>
        <button class="page-btn next-btn" onclick="nextPage()">下一页</button>
      </div>
      </main>
      <aside class="posts-index-rail" aria-label="阅读与文章筛选">
      <ReadingDeskEntry compact />
      <a class="posts-mobile-desk" href="/desk/">拾页阅读桌 ↗</a>
      <details class="posts-index-filters" data-post-filters open><summary>标签与专栏 <span aria-hidden="true">⌄</span></summary>
      <div class="posts-fold-panel" id="tagFilterPanel">
        <button class="posts-fold-toggle" type="button" data-target="tagFilterWrap">
          <i class="fa-solid fa-tag"></i>标签 <span class="posts-fold-count" id="tagCount">0</span>
        </button>
        <div class="posts-fold-content" id="tagFilterWrap">
          <div id="tagFilter" class="tag-filter"></div>
        </div>
      </div>
      <div class="posts-fold-panel" id="columnFilterPanel">
        <button class="posts-fold-toggle" type="button" data-target="columnFilterWrap">
          <i class="fa-solid fa-folder-open"></i>专栏 <span class="posts-fold-count" id="columnCount">0</span>
        </button>
        <div class="posts-fold-content" id="columnFilterWrap">
          <div id="columnFilter" class="tag-filter"></div>
        </div>
      </div>
      </details>
      </aside>
      </div>
    </div>

    <div class="copyright">© 2024 - {currentYear} 蓝色奇夸克 / {SITE_TITLE} All rights reserved</div>
    <script is:inline src="/assets/js/posts.js"></script>
  </body>
</html>







