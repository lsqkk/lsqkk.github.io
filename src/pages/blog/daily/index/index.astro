---
import BlogFeatureLayout from '../../../../layouts/BlogFeatureLayout.astro';
import archive from '../../../../../assets/pages/blog/daily/articles.json';

const byUrl = new Map();
const dated = archive.dailyArticles.map(({ date, articles }) => ({
  date: date.split('-').map(part => part.padStart(2, '0')).join('-'),
  articles,
})).sort((a, b) => b.date.localeCompare(a.date));
for (const day of dated) {
  for (const article of day.articles) {
    const url = new URL(article.url);
    if (url.protocol !== 'https:' || !['www.zhihu.com', 'zhuanlan.zhihu.com'].includes(url.hostname)) continue;
    url.search = '';
    url.hash = '';
    if (!byUrl.has(url.href)) byUrl.set(url.href, { ...article, url: url.href, date: day.date });
  }
}
const articles = [...byUrl.values()];
const tags = [...new Set(articles.flatMap(article => article.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const months = Object.groupBy(articles, article => article.date.slice(0, 7));
---
<BlogFeatureLayout title="知选 · 阅读档案" path="/blog/daily/" description="原「夸克日报」的知乎收藏。按主题回看，或用手上的几分钟挑出一组短读。">
  <div class="feature-stack" data-reading-archive>
    <div class="feature-panel feature-controls" data-archive-controls hidden>
      <label>搜索收藏 <input type="search" data-archive-search placeholder="标题、作者或主题" /></label>
      <label>主题 <select data-archive-tag><option value="">全部主题</option>{tags.map(tag => <option>{tag}</option>)}</select></label>
      <label>空闲时间
        <select data-archive-budget>
          <option value="5">5 分钟</option>
          <option value="10" selected>10 分钟</option>
          <option value="20">20 分钟</option>
          <option value="30">30 分钟</option>
        </select>
      </label>
      <button type="button" data-archive-pick>生成短读清单</button>
      <button type="button" data-archive-reset hidden>查看筛选结果</button>
    </div>
    <section class="feature-panel feature-archive">
      <h2 data-archive-heading>收藏档案</h2>
      <p class="feature-meta" role="status" data-archive-status>收录 {articles.length} 篇，收藏于 {dated.at(-1)?.date} 至 {dated[0]?.date}。</p>
      <div data-archive-months>
        {Object.entries(months).map(([month, entries], index) => (
          <details open={index === 0}>
            <summary>{month} · {entries.length} 篇</summary>
            <ul class="feature-list">
              {entries.map(article => (
                <li data-archive-entry data-tags={JSON.stringify(article.tags)} data-minutes={article.readTime}>
                  <div>
                    <h3><a href={article.url} target="_blank" rel="noopener noreferrer">{article.title}</a></h3>
                    <p class="feature-meta">{article.author} · {article.tags.join(' / ')} · 约 {article.readTime} 分钟 · <time datetime={article.date}>{article.date}</time></p>
                  </div>
                  <button type="button" aria-label={`已读状态：${article.title}`} aria-pressed="false" data-archive-read hidden>标为已读</button>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </div>
  <script is:inline type="module" src="/assets/pages/blog/daily/daily.js"></script>
</BlogFeatureLayout>
