---
import BlogFeatureLayout from '../../../../layouts/BlogFeatureLayout.astro';
import groups from '../../../../../assets/pages/blog/hot/sources.json';

const names = Object.fromEntries(groups.flatMap(group => Object.entries(group.sources)));
const initialSources = ['weibo', 'zhihu'];
---
<BlogFeatureLayout title="热榜对照" path="/blog/hot/" description="并排看两个平台今天在讨论什么。再次刷新时，对照浏览器保存的上一份榜单查看名次变化。">
  <div class="feature-stack" data-hotboard>
    <div class="feature-panel feature-controls" data-hot-controls hidden>
      {initialSources.map((source, index) => (
        <label>{index === 0 ? '榜单一' : '榜单二'}
          <select data-hot-source>
            {groups.map(group => <optgroup label={group.name}>
              {Object.entries(group.sources).map(([id, name]) => <option value={id} selected={id === source}>{name}</option>)}
            </optgroup>)}
          </select>
        </label>
      ))}
      <label>筛选话题 <input type="search" data-hot-search placeholder="输入关键词" /></label>
      <button type="button" data-hot-refresh>刷新榜单</button>
    </div>
    <div class="feature-split">
      {initialSources.map(source => (
        <section class="feature-panel" data-hot-panel>
          <h2 data-hot-title>{names[source]}</h2>
          <p class="feature-meta" role="status" data-hot-status hidden></p>
          <ol class="feature-list" data-hot-list hidden></ol>
          <p class="feature-footer"><a data-hot-upstream href={'https://uapis.cn/hotboard/' + source} target="_blank" rel="noopener noreferrer">在数据源查看榜单</a></p>
        </section>
      ))}
    </div>
  </div>
  <script is:inline type="module" src="/assets/pages/blog/hot/hot.js"></script>
</BlogFeatureLayout>
