---
import { SITE_TITLE, SITE_LOGO_URL } from "@siteConfig";
import CommentIdentityFields from "../../../../components/CommentIdentityFields.astro";
---

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <link rel="stylesheet" href="/assets/css/basic.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>留言板 - {SITE_TITLE}</title>
    <link rel="stylesheet" href="/assets/css/fa-local.css" />
    <link rel="stylesheet" href="/assets/pages/blog/lyb/lyb.css">
    <link rel="icon" href={SITE_LOGO_URL} type="image/png">
    <link rel="stylesheet" href="/assets/css/cursor.css">
    <script is:inline src="/assets/js/cursor-trail.js"></script>
    <script is:inline src="/assets/js/marked.min.js"></script>
    <script is:inline src="/assets/js/nav.js"></script>
</head>

<body class="lyb-page">


    <div class="container">

        <!-- Header -->
        <header class="lyb-header">
            <div><h1 class="page-title">留言板</h1><p>给站长的建议、遇到的问题，或想分享的一句话。</p></div>
            <div class="header-toolbar">
                <a href="/" class="nav-link"><i class="fas fa-home"></i> 主页</a>
                <a href="/a/chat-room/" class="nav-link"><i class="fas fa-comments"></i> 聊天室</a>
                <a href="/blog/tieba/" class="nav-link"><i class="fas fa-comments"></i> 贴吧</a>
                <button class="admin-toggle" id="adminToggle" onclick="toggleAdminPanel()" title="管理">
                    <i class="fas fa-cog"></i>
                </button>
            </div>
        </header>

        <!-- Admin inline (hidden by default) -->
        <div class="admin-inline" id="adminPanel" style="display: none;">
            <div class="admin-inner" id="adminLoginForm">
                <span class="admin-label">管理员</span>
                <input type="password" id="adminPassword" placeholder="输入密码">
                <button class="admin-btn" onclick="adminLogin()">登录</button>
            </div>
            <div class="admin-inner" id="adminActions" style="display: none;">
                <span class="admin-label"><i class="fas fa-shield-alt"></i> 管理员模式</span>
                <button class="admin-btn" onclick="logoutAdmin()">退出</button>
            </div>
        </div>

        <!-- Main glass panel: form + messages -->
        <div class="main-section">

            <!-- Compose area -->
            <section class="compose-area" aria-labelledby="composeTitle"><h2 id="composeTitle">写一条留言</h2>
                <div class="compose-identity">
                    <CommentIdentityFields variant="lyb" />
                </div>
                <div class="lyb-fields">
                    <label for="messageCategory">话题</label>
                    <select id="messageCategory">
                        <option value="general">随手留言</option>
                        <option value="idea">建议</option>
                        <option value="issue">问题反馈</option>
                    </select>
                </div>
                <label for="messageContent" class="lyb-sr">留言内容</label>
                <textarea id="messageContent" rows="5" maxlength="5000" placeholder="写下你的留言…" class="compose-input"></textarea>
                <div id="messagePreview" class="message-content lyb-preview" aria-label="留言预览" hidden></div>
                <div class="compose-footer">
                    <label class="markdown-toggle">
                        <input type="checkbox" id="useMarkdown" checked>
                        <span>Markdown</span>
                    </label>
                    <button type="button" id="previewToggle" class="lyb-secondary" aria-pressed="false">预览</button><button type="button" id="publishMessage" class="submit-btn" onclick="submitMessage()"><i class="fas fa-paper-plane"></i> 发布留言</button>
                </div>
                <div class="lyb-compose-meta"><span id="composeStatus" role="status"></span><span id="composeCount">0 / 5000</span></div>
            </section>

            <!-- Messages area -->
            <section class="messages-area" aria-label="留言列表">
                <div class="messages-header">
                    <span class="messages-title">全部留言 <span class="messages-count" id="messageCount">0</span></span>
                    <div class="messages-controls">
                        <div class="sort-group" id="sortGroup">
                            <button class="sort-btn active" aria-pressed="true" data-sort="newest" onclick="setSort('newest')">最新</button>
                            <button class="sort-btn" aria-pressed="false" data-sort="oldest" onclick="setSort('oldest')">最早</button>
                            <button class="sort-btn" aria-pressed="false" data-sort="hot" onclick="setSort('hot')">最热</button>
                        </div>
                        <div class="search-wrapper">
                            <i class="fas fa-search search-icon-inline"></i>
                            <input type="text" id="searchInput" aria-label="搜索留言" placeholder="搜索留言…" class="search-input-inline">
                        </div>
                    </div>
                </div>

                <div class="lyb-feed-tools">
                    <label for="categoryFilter" class="lyb-sr">按话题筛选</label>
                    <select id="categoryFilter"><option value="">全部话题</option><option value="general">随手留言</option><option value="idea">建议</option><option value="issue">问题反馈</option></select>
                    <label class="markdown-toggle"><input type="checkbox" id="savedOnly" /> 只看收藏</label>
                </div>
                <p id="feedStatus" class="lyb-feed-status" role="status"></p>
                <div class="messages-list" id="messagesContainer">
                    <!-- 留言将通过JavaScript动态加载 -->
                </div>

                <div class="pagination" id="pagination">
                    <!-- 分页按钮将通过JavaScript动态生成 -->
                </div>
            </section>

        </div>
    </div>

    <script is:inline src="__API_BASE__/api/firebase-config?v=1"></script>
    <script is:inline src="/assets/js/firebase-ready.js"></script>
    <script is:inline src="/assets/js/comment-shared.js"></script>
    <script is:inline src="/assets/js/comment-input-shared.js"></script>
    <script is:inline src="/assets/js/comment-list-shared.js"></script>
    <script is:inline src="/assets/js/safe-markdown.js"></script>
    <script is:inline src="/assets/js/comment-render-shared.js"></script>
    <script is:inline src="/assets/pages/blog/lyb/lyb.js"></script>
</body>

</html>
