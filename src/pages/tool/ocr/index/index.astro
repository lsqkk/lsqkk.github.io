---
import LuxuryBackground from "../../../../components/LuxuryBackground.astro";
import { SITE_TITLE, SITE_LOGO_URL } from "@siteConfig";
---

<!DOCTYPE html>
<html lang="zh-CN">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OCR 文字识别与原图校对 - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} type="image/png">
    <script is:inline defer src="/assets/js/nav.js"></script>

    <link rel="stylesheet" href="/assets/css/cursor.css">
    <script is:inline defer src="/assets/js/cursor-trail.js"></script>
    <link rel="stylesheet" href="/assets/pages/tool/ocr/ocr.css">
    <link rel="stylesheet" href="/assets/css/basic.css">
    <link rel="stylesheet" href="/assets/css/feature-pages.css">
    <link rel="stylesheet" href="/assets/css/tool-handoff.css">
</head>

<body class="ocr-page luxury-body feature-page feature-ocr">
    <nav class="feature-breadcrumb" aria-label="当前位置"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/tool/">工具箱</a><span aria-hidden="true">↗</span></nav>

    <LuxuryBackground />
    <div class="container">
        <h1>OCR 文字识别与原图校对</h1>
        <p class="subtitle">批量识别后，从引擎最拿不准的词开始，点一下就能回到原图。</p>

        <div class="upload-area" id="dropArea">
            <p>选择、拖放图片，或直接粘贴截图</p>
            <input type="file" id="fileInput" accept="image/*" multiple style="display: none;">
            <button class="btn" id="selectBtn">选择图片</button>
            <button class="btn" id="ocrSample" type="button">用示例试一下</button>
        </div>

        <div id="imagePreviews"></div>

        <div class="language-selector">
            <label for="language">识别语言: </label>
            <select id="language" class="ocr-language-select">
                <option value="eng">English</option>
                <option value="chi_sim+eng" selected>简体中文 + 英语</option>
                <option value="chi_tra">繁體中文</option>
                <option value="jpn">日本語</option>
                <option value="kor">한국어</option>
                <option value="fra">Français</option>
                <option value="deu">Deutsch</option>
                <option value="spa">Español</option>
                <option value="rus">Русский</option>
            </select>
        </div>

        <div class="progress-container" id="progressContainer">
            <div class="progress-bar">
                <div class="progress" id="progressBar"></div>
            </div>
            <div class="status" id="statusText" role="status">准备就绪</div>
        </div>

        <div style="text-align: center;">
            <button class="btn" id="recognizeBtn" disabled>开始识别</button>
        </div>

        <section id="ocrReview" hidden aria-labelledby="ocrReviewTitle">
            <h2 id="ocrReviewTitle">疑点校对</h2>
            <div class="ocr-review-controls">
                <label for="ocrPage">原图</label>
                <select id="ocrPage"></select>
                <label for="ocrThreshold">置信度低于</label>
                <select id="ocrThreshold">
                    <option value="60">60</option>
                    <option value="80" selected>80</option>
                    <option value="90">90</option>
                    <option value="101">显示全部</option>
                </select>
            </div>
            <div class="ocr-review-grid">
                <div class="ocr-source">
                    <img id="ocrSourceImage" alt="识别文字的原图">
                    <span id="ocrSourceMark" hidden></span>
                </div>
                <div>
                    <p id="ocrReviewStatus" role="status"></p>
                    <canvas id="ocrDetail" hidden aria-label="当前疑点的原图局部"></canvas>
                    <div class="ocr-review-controls">
                        <button id="ocrPrev" type="button" class="btn">上一处</button>
                        <button id="ocrNext" type="button" class="btn">下一处</button>
                        <button id="ocrLocate" type="button" class="btn">选中结果里的词</button>
                    </div>
                </div>
            </div>
        </section>

        <label for="resultText">识别结果（可直接修改）</label>
        <textarea id="resultText" placeholder="识别结果将显示在这里..." readonly></textarea>

        <div class="action-buttons">
            <button class="btn" id="copyBtn" disabled>复制文本</button>
            <button class="btn" id="exportBtn" disabled>导出为TXT</button>
            <button class="btn" id="ocrHandoff" type="button" disabled>送到 Markdown</button>
            <button class="btn" id="clearBtn">清空所有</button>
            <button class="btn" id="moreToolsBtn">更多工具</button>
        </div>
    </div>

    <footer>
        <p>© 2024 - <span id="currentYear"></span> <a href="/posts/copyright" target="_blank" title="版权信息">{SITE_TITLE} /
                蓝色奇夸克</a> All rights reserved.</p>
        <p>基于Tesseract.js的纯前端OCR工具 - 数据完全在本地处理，不会上传到服务器</p>
    </footer>

    <script is:inline type="module" src="/assets/pages/tool/ocr/ocr.js"></script>
</body>

</html>






