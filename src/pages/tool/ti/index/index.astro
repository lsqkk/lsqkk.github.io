---
import LuxuryBackground from "../../../../components/LuxuryBackground.astro";
import { SITE_TITLE, SITE_LOGO_URL } from "@siteConfig";
---

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>思政题库抽测 - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} type="image/png">
    <link rel="stylesheet" href="/assets/css/basic.css">
    <link rel="stylesheet" href="/assets/css/cursor.css">
    <script is:inline defer src="/assets/js/cursor-trail.js"></script>
    <script is:inline defer src="/assets/js/nav.js"></script>
    <link rel="stylesheet" href="/assets/pages/tool/ti/ti.css">
    <link rel="stylesheet" href="/assets/css/feature-pages.css">
</head>

<body class="luxury-body feature-page feature-ti">
    <nav class="feature-breadcrumb" aria-label="当前位置"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/tool/">工具箱</a><span aria-hidden="true">↗</span></nav>
    <LuxuryBackground />

    <main class="ti-shell">
        <header class="ti-header">
            <p class="ti-kicker">QUIZ / IDEOLOGY</p>
            <h1 id="title-text">《思想道德与法治》题库抽测</h1>
            <p class="ti-subtitle">按章节范围随机抽题，逐题自测并记录掌握情况。</p>
        </header>

        <section id="config-ui" class="ti-panel">
            <div class="ti-field">
                <span class="ti-label">起始范围</span>
                <div class="range-picker">
                    <select id="start-chap" onchange="updateSecDropdown('start')"></select>
                    <select id="start-sec"></select>
                </div>
            </div>
            <div class="ti-field">
                <span class="ti-label">结束范围</span>
                <div class="range-picker">
                    <select id="end-chap" onchange="updateSecDropdown('end')"></select>
                    <select id="end-sec"></select>
                </div>
            </div>
            <label class="ti-check">
                <input type="checkbox" id="show-a" checked>
                <span>显示条数提醒 (a)</span>
            </label>
            <div class="ti-actions">
                <button class="primary-btn" type="button" onclick="startQuiz()">开始抽题</button>
                <button class="ghost-btn" type="button" onclick="toggleStats()">查看统计记录</button>
            </div>
        </section>

        <section id="quiz-ui" class="ti-panel hidden">
            <div class="progress-bar" id="quiz-progress"></div>
            <div id="question-display">...</div>
            <div id="answer-hint" class="hint-text"></div>
            <div class="ti-actions">
                <button class="ghost-btn" type="button" onclick="handleResult(false)">不会</button>
                <button class="primary-btn" type="button" onclick="handleResult(true)">我会</button>
            </div>
            <button class="ti-exit" type="button" onclick="location.reload()">放弃并返回</button>
        </section>

        <section id="stats-ui" class="ti-panel hidden">
            <div id="stats-container"></div>
            <div class="ti-actions">
                <button class="primary-btn" type="button" onclick="location.reload()">返回</button>
            </div>
        </section>
    </main>

    <script is:inline src="/assets/pages/tool/ti/ti.js"></script>
</body>

</html>
