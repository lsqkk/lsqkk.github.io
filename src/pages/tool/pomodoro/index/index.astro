---
import { SITE_TITLE, SITE_LOGO_URL } from "@siteConfig";
const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="zh-CN">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>智能番茄钟 - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} type="image/png">
    <script is:inline defer src="/assets/js/nav.js"></script>
    <link rel="stylesheet" href="/assets/css/basic.css">
    <link rel="stylesheet" href="/assets/pages/tool/pomodoro/style.css">
    <link rel="stylesheet" href="/assets/css/feature-pages.css">
</head>

<body class=" feature-page feature-pomodoro">
    <nav class="feature-breadcrumb" aria-label="当前位置"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/tool/">工具箱</a><span aria-hidden="true">↗</span></nav>
    <div class="container">

        <div class="timer-card">
            <h1 class="timer-title">番茄工作法计时器</h1>

            <div class="time-options">
                <button type="button" class="time-option active" data-time="1500" aria-pressed="true">25 分钟</button>
                <button type="button" class="time-option" data-time="3000" aria-pressed="false">50 分钟</button>

            </div>
            <button class="theme-toggle" id="themeToggle" aria-label="切换番茄钟配色">🌓</button>
            <p class="timer-note">一次只专注一件事。</p>
            <div id="timer" class="timer" role="timer" aria-label="剩余专注时间">25:00</div>

            <div class="progress-container">
                <div class="progress-bar" id="progressBar"></div>
            </div>

            <div class="controls">
                <button id="start">开始</button>
                <button id="stop" disabled>暂停</button>
                <button id="reset">重置</button>
            </div>
        </div>
    </div>

    <a class="footer" href="/posts/copyright" target="_blank">
        © 2024 - {currentYear} 蓝色奇夸克 - {SITE_TITLE} All rights reserved.
    </a>

    <audio id="alarmSound" src="https://assets.mixkit.co/sfx/preview/mixkit-alarm-digital-clock-beep-989.mp3"
        preload="none"></audio>

    <script is:inline src="/assets/pages/tool/pomodoro/app.js"> </script>
</body>

</html>