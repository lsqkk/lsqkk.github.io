---
import { SITE_TITLE, SITE_LOGO_URL, SITE_URL, SITE_DOMAIN } from "@siteConfig";
import LuxuryBackground from "../../components/LuxuryBackground.astro";

const pageTitle = `站内搜索 - ${SITE_TITLE}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={SITE_LOGO_URL} type="image/png" />
    <link rel="stylesheet" href="/assets/css/basic.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="stylesheet" href="/assets/css/site-search.css" />
    <link rel="stylesheet" href="/assets/css/fa-local.css" />
    <script is:inline src="/assets/js/nav.js"></script>
  </head>
  <body class="search-body luxury-body">
    <LuxuryBackground />
    <h1 class="search-page-title">站内搜索</h1>
    <div class="search-shell">
      <form class="search-box" id="siteSearchForm">
        <input type="text" id="siteSearchInput" name="q" maxlength="120" aria-label="搜索本站文章、动态与页面" placeholder="输入关键词，按回车搜索..." />
        <button id="siteSearchBtn">搜索</button>
      </form>
      <div class="search-options"><div class="search-mode">
        <label class="search-toggle">
          <input type="checkbox" id="siteSearchFulltext" name="full" value="1" />
          <span>全文搜索（文章/动态正文）</span>
        </label>
      </div>
      <div class="search-actions">
        <a id="bingSearchLink" data-site={SITE_DOMAIN} class="bing-link" href={`https://cn.bing.com/search?q=site%3A${SITE_DOMAIN}`} target="_blank" rel="noreferrer">使用必应全站搜索</a>
      </div>
      </div>
      <div id="siteSearchStatus" class="search-status" role="status" aria-live="polite">请输入关键词开始搜索</div>
      <div id="siteSearchResults" class="search-results"></div>
    </div>

    <script is:inline type="module" src="/assets/js/site-search.js"></script>
  </body>
</html>
