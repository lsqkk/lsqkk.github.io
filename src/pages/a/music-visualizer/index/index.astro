---
import { SITE_TITLE, SITE_LOGO_URL } from "@siteConfig";
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>声音频谱实验室 - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} type="image/png">
    <link rel="stylesheet" href="/assets/css/basic.css">
    <link rel="stylesheet" href="/assets/css/feature-pages.css">
    <link rel="stylesheet" href="/assets/pages/a/music-visualizer/music.css">
    <script is:inline defer src="/assets/js/nav.js"></script>
</head>
<body class="feature-page music-page">
    <nav class="feature-breadcrumb" aria-label="当前位置"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/a/">实验室</a></nav>
    <main class="container">
        <h1>声音频谱实验室</h1>
        <p class="subtitle">边听边看声音的频率变化，给难辨的片段标上起止点，反复听。</p>
        <div class="music-actions">
            <button type="button" id="playBtn">播放扫频示例</button>
            <label for="audioInput">选择本地音频</label>
            <input type="file" id="audioInput" accept="audio/*">
        </div>
        <p id="audioStatus" role="status">可以载入录音或音乐，音频文件在当前浏览器播放。</p>
        <audio id="player" controls preload="metadata" aria-label="音频播放器" hidden></audio>
        <div id="loopControls" class="music-actions" hidden>
            <button type="button" id="markA">标记 A 点</button>
            <button type="button" id="markB">标记 B 点</button>
            <button type="button" id="loopToggle" aria-pressed="false">循环 A–B</button>
            <button type="button" id="clearLoop">清除标记</button>
        </div>
        <p id="loopStatus" role="status" hidden></p>

        <div class="music-actions visualization-controls" aria-label="声音视图">
            <button type="button" data-viz="spectrogram" aria-pressed="true">滚动声谱</button>
            <button type="button" data-viz="particles" aria-pressed="false">粒子</button>
            <button type="button" data-viz="waves" aria-pressed="false">波形</button>
            <button type="button" data-viz="spectrum" aria-pressed="false">频谱</button>
            <button type="button" data-viz="rings" aria-pressed="false">光环</button>
        </div>
        <section id="spectrogramPanel" aria-label="频率随时间的变化">
            <div class="spectrogram-plot">
                <canvas id="spectrogram" width="240" height="144" aria-label="滚动声谱图，横轴为时间，纵轴为频率"></canvas>
                <div class="frequency-axis" aria-hidden="true">
                    <span style="top:0%">12 kHz</span>
                    <span style="top:34%">2 kHz</span>
                    <span style="top:60%">500 Hz</span>
                    <span style="top:100%">60 Hz</span>
                </div>
            </div>
            <div class="time-axis"><span>约 8 秒前</span><span>现在</span></div>
            <p class="music-note">越亮表示该频率分量越强。暂停可留住当前画面，跳转播放位置会清除旧画面。</p>
        </section>

        <section id="scenePanel" aria-label="三维可视化" hidden>
            <div class="music-actions">
                <label for="colorScheme">配色</label>
                <select id="colorScheme">
                    <option value="neon">霓虹</option>
                    <option value="ocean">海洋</option>
                    <option value="sunset">日落</option>
                    <option value="forest">森林</option>
                </select>
            </div>
            <div id="container"></div>
        </section>
    </main>
    <script is:inline defer src="/assets/js/three.min.js"></script>
    <script is:inline defer src="/assets/js/OrbitControls.js"></script>
    <script is:inline type="module" src="/assets/pages/a/music-visualizer/music.js"></script>
</body>
</html>
