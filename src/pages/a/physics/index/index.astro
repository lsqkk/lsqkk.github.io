---
import PhysicsLayout from "../../../../components/physics/PhysicsLayout.astro";
import projects from "../../../../../assets/pages/a/physics/projects.json";

import { categories, experiments, previewCurve } from "../../../../../assets/pages/a/physics/experiments.mjs";

const sections = Object.entries(categories).map(([id, title]) => ({
    id, title, projects: [
        ...(projects[id as keyof typeof projects] ?? []).map(project => ({ ...project, curve: "" })),
        ...experiments.filter(lab => lab.category === id).map(lab => ({
            ...lab, link: lab.category + "/" + lab.slug, symbol: "", curve: previewCurve(lab)
        }))
    ]
}));
const count = sections.reduce((sum, section) => sum + section.projects.length, 0);
const universityCount = experiments.filter(lab => lab.level === "university").length;

const illustrations = {
    reflection: "M8 64H152 M80 14V76 M24 22L80 64 136 22",
    refraction: "M8 48H152 M80 8V88 M34 10L80 48 101 86",
    slits: "M58 8V26 M58 36V60 M58 70V88 M72 31Q104 6 136 31 M72 65Q104 90 136 65 M75 48H149",
    sphere: "M80 12a36 36 0 1 0 0 72 36 36 0 1 0 0-72Z M80 12a17 36 0 1 0 0 72 17 36 0 1 0 0-72Z M44 48h72",
    field: "M64 13a35 35 0 1 0 0 70 35 35 0 1 0 0-70Z M96 13a35 35 0 1 0 0 70 35 35 0 1 0 0-70Z M64 30a18 18 0 1 0 0 36 18 18 0 1 0 0-36Z M96 30a18 18 0 1 0 0 36 18 18 0 1 0 0-36Z",
    wave: "M8 48H152 M8 48Q26 0 44 48T80 48 116 48 152 48",
    pendulum: "M52 16h56 M80 16v64 M80 16l37 49 M43 65a62 62 0 0 0 74 0 M124 65a7 7 0 1 0-14 0 7 7 0 0 0 14 0Z",
};
---
<PhysicsLayout title="物理实验室" description="调节仪器、追踪运动、读取数据，亲手验证光学、力学、电磁学和近代物理的规律。">
    <nav class="physics-jumps" slot="intro" aria-label="实验分类">
        {sections.map(section => <a href={`#${section.id}`}>{section.title}<span>{section.projects.length}</span></a>)}
    </nav>
    <section class="physics-featured" aria-labelledby="physics-featured-title">
        <div class="physics-featured-copy">
            <p>大学物理 · 波动光学</p>
            <h2 id="physics-featured-title">从一圈暗纹，<br />测出透镜的曲率</h2>
            <p>旋转平凸透镜装置，沿显微镜视野的半径寻找暗环，用两次读数反推曲率半径。</p>
            <a href="/a/physics/optics/newton-rings/">进入牛顿环实验 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="physics-featured-figure" aria-hidden="true"><i></i><b></b></div>
    </section>
    <div class="physics-search">
        <label for="lab-search">查找实验</label>
        <input id="lab-search" type="search" placeholder="例如：光栅、霍尔、共振">
        <label class="physics-filter"><input id="university-only" type="checkbox"> 大学物理 · {universityCount}</label>
        <span id="lab-count" role="status">{count} 个实验 · {sections.length} 个类别</span>
    </div>
    {sections.map(section => (
        <section class="physics-category" data-category={section.id} id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title} <span>{section.projects.length} 个实验</span></h2>
            <div class="physics-catalog">
                {section.projects.map(project => (
                    <a class="physics-card" href={`/a/physics/${project.link}/`} data-level={"level" in project ? project.level : "foundation"}>
                        <div class="physics-card-figure">
                            <svg aria-hidden="true" viewBox="0 0 160 96"><path d={project.curve || illustrations[project.symbol as keyof typeof illustrations]} /></svg>
                        </div>
                        <div class="physics-card-body">
                            <p class="physics-card-topic">{project.topics}</p>
                            <h3>{project.name}<span aria-hidden="true">↗</span></h3>
                            <p>{project.description}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    ))}
</PhysicsLayout>
<script>
    const search = document.querySelector<HTMLInputElement>("#lab-search")!;
    const university = document.querySelector<HTMLInputElement>("#university-only")!;
    const count = document.querySelector("#lab-count")!;
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".physics-category"));
    function filter() {
        const terms = search.value.trim().toLowerCase().split(/\s+/);
        let visible = 0;
        let categories = 0;
        for (const section of sections) {
            const title = section.querySelector("h2")?.textContent ?? "";
            let hits = 0;
            for (const card of section.querySelectorAll<HTMLElement>(".physics-card")) {
                const content = (title + card.textContent).toLowerCase();
                card.hidden = (university.checked && card.dataset.level !== "university") || !terms.every(term => content.includes(term));
                if (!card.hidden) hits++;
            }
            section.hidden = !hits;
            const link = document.querySelector<HTMLElement>('.physics-jumps a[href="#' + section.id + '"]');
            if (link) link.hidden = !hits;
            if (hits) categories++;
            visible += hits;
        }
        count.textContent = visible ? visible + " 个实验 · " + categories + " 个类别" : "未找到实验";
    }
    search.addEventListener("input", filter);
    university.addEventListener("input", filter);
    window.addEventListener("pageshow", filter);
</script>
