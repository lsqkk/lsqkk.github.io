---
import PhysicsLayout from "../../../../../components/physics/PhysicsLayout.astro";
import ExperimentWorkbench from "../../../../../components/physics/ExperimentWorkbench.astro";
const parameters = [
    { id: "light-angle", label: "光束方向（顺时针）", min: -180, max: 180, step: 1, value: 42, initial: "42°" },
    { id: "mirror-angle", label: "镜面角度（顺时针）", min: -180, max: 180, step: 1, value: 0, initial: "0°" },
];
---
<PhysicsLayout title="平面镜反射" category="optics" description="搭建光路，比较每次反射的入射角和反射角。">
    <ExperimentWorkbench canvasLabel="可拖动的光源与平面镜反射光路" caption="拖动圆点移动光源，拖动小圆点改变方向，拖动方形端点改变镜面。浅青侧为镜面反射侧。"
        parameters={parameters} measurements={[{ id: "incident", label: "选中光源 · 首次入射角" }, { id: "reflected", label: "选中光源 · 首次反射角" }, { id: "bounces", label: "选中光源 · 反射次数" }]} script="mirror/mirror">
        <Fragment slot="before-parameters">
            <label class="physics-parameter">光源<select id="selected-light"></select></label>
            <label class="physics-parameter">镜面<select id="selected-mirror"></select></label>
        </Fragment>
        <div class="physics-actions">
            <button type="button" id="add-light">添加光源</button>
            <button type="button" id="remove-light">移除所选光源</button>
            <button type="button" id="add-mirror">添加镜面</button>
            <button type="button" id="remove-mirror">移除所选镜面</button>
            <button type="button" id="toggle-animation">暂停</button>
            <button type="reset">重置</button>
        </div>
        <section class="physics-notes" slot="notes">
            <h2>从法线量角</h2>
            <p>浅色虚线垂直于镜面，表示入射点的法线。拖动光源或调整方向，再比较两个读数。两块镜面可以产生连续反射，模拟最多追踪六次。</p>
            <p>镜面背面吸收光线。场景使用理想镜面，移动的亮点用于显示传播方向。</p>
        </section>
    </ExperimentWorkbench>
</PhysicsLayout>
