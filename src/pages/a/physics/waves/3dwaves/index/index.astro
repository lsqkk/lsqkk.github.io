---
import PhysicsLayout from "../../../../../../components/physics/PhysicsLayout.astro";
const parameters = [
    { id: "wavelength", label: "波长 λ", min: .5, max: 3, step: .1, value: 1.5, initial: "1.5 m" },
    { id: "frequency", label: "频率 f", min: .2, max: 2, step: .1, value: .8, initial: "0.8 Hz" },
    { id: "amplitude", label: "波源振幅", min: .1, max: 1, step: .1, value: .5, initial: "0.5" },
    { id: "order", label: "最高反射阶数", min: 0, max: 4, step: 1, value: 1, initial: "1" },
    { id: "source-x", label: "波源横坐标 x", min: -1.5, max: 1.5, step: .1, value: 0, initial: "0.0 m" },
    { id: "slice", label: "切面高度 y", min: -2, max: 2, step: .1, value: 0, initial: "0.0 m" },
];
---
<PhysicsLayout title="三维球面波" category="waves" description="从直达波开始逐阶加入反射，观察立方腔里的波形如何改变。">
    <div class="physics-workbench">
        <figure class="physics-stage">
            <div id="wave-view" class="physics-webgl" role="img" aria-label="立方腔内的球面波">
                <canvas id="fallback-view" width="500" height="300" hidden></canvas>
                <p id="webgl-message" class="physics-error" role="status">正在初始化球面波画布…</p>
            </div>
            <dl class="physics-measurements">
                <div><dt>参与计算的波源（含镜像）</dt><dd id="image-count">—</dd></div>
                <div><dt>波速 v = λf</dt><dd id="speed">—</dd></div>
                <div><dt>腔体边长</dt><dd>4.0 m</dd></div>
            </dl>
            <figcaption id="scene-caption">浅青为正位移，蓝紫为负位移，橙点是波源。拖动旋转视角，滚轮或双指缩放，也可使用视角按钮。</figcaption>
        </figure>
        <section class="physics-controls" aria-labelledby="physics-controls-title">
            <h2 id="physics-controls-title">实验参数</h2>
            <form id="experiment-form">
                {parameters.map(parameter => (
                    <label class="physics-parameter">
                        <span>{parameter.label}<output for={parameter.id} id={`${parameter.id}-output`}>{parameter.initial}</output></span>
                        <input id={parameter.id} type="range" min={parameter.min} max={parameter.max} step={parameter.step} value={parameter.value}>
                    </label>
                ))}
                <label class="physics-parameter">显示方式<select id="view"><option value="slice">水平切面</option><option value="volume">体积点云</option></select></label>
                <div class="physics-actions">
                    <button type="button" id="toggle-animation">暂停</button>
                    <button type="button" id="rotate">旋转视角</button>
                    <button type="button" id="view-home">初始视角</button>
                    <button type="reset">重置</button>
                </div>
            </form>
        </section>
    </div>
    <section class="physics-notes">
        <h2>从镜像波源看反射</h2>
        <p>先选 0 阶看直达波，再依次加入反射。每个虚拟镜像源对应一条反射路径，单次反射取振幅系数 0.5。把波源移到一侧，检查对称性如何变化。</p>
        <p>模型采用稳态相干叠加，忽略墙面相移，并在波源附近限制振幅。水平切面可观察腔体不同高度的波场。</p>
    </section>
    <script is:inline src="/assets/js/three.min.js"></script>
    <script is:inline src="/assets/js/OrbitControls.js"></script>
    <script is:inline type="module" src="/assets/pages/a/physics/waves/3dwaves/3dwaves.mjs"></script>
</PhysicsLayout>
