---
import PhysicsLayout from "../../../../../../components/physics/PhysicsLayout.astro";
import ExperimentWorkbench from "../../../../../../components/physics/ExperimentWorkbench.astro";
const parameters = [
    { id: "wavelength", label: "波长 λ", min: .45, max: 3, step: .05, value: 1.25, initial: "1.25 m" },
    { id: "frequency", label: "频率 f", min: .1, max: 1.2, step: .05, value: .45, initial: "0.45 Hz" },
    { id: "amplitude", label: "振幅 A", min: .2, max: 1, step: .05, value: .7, initial: "0.70 m" },
    { id: "source-x", label: "选中波源 x", min: .5, max: 9.5, step: .05, value: 3.5, initial: "3.50 m" },
    { id: "source-y", label: "选中波源 y", min: .5, max: 5.5, step: .05, value: 3, initial: "3.00 m" },
    { id: "phase", label: "两源相位差", min: 0, max: 360, step: 15, value: 0, initial: "0°" },
];
---
<PhysicsLayout title="二维波场" category="waves" description="摆放相干点波源，切换瞬时波场与干涉振幅图，寻找相消位置。">
    <ExperimentWorkbench canvasLabel="二维波场及可移动点波源" caption="瞬时图中，浅青是正位移，蓝紫是负位移。振幅图中，亮度代表振幅。点按画布移动选中的波源。"
        parameters={parameters} measurements={[{ id: "speed", label: "波速 v = λf" }, { id: "separation", label: "波源间距" }, { id: "time", label: "模拟时刻" }]} script="waves/planewave/planewave">
        <Fragment slot="before-parameters">
            <label class="physics-parameter">波源配置<select id="mode"><option value="single">单点源</option><option value="double" selected>双点源</option><option value="plane">平面波</option></select></label>
            <label class="physics-parameter">观察量<select id="view"><option value="instant">瞬时位移</option><option value="amplitude">振幅</option></select></label>
            <label class="physics-parameter">选中波源<select id="source"><option value="0">波源 A</option><option value="1">波源 B</option></select></label>
        </Fragment>
        <div class="physics-actions">
            <button type="button" id="toggle-animation">暂停</button>
            <button type="button" id="step">步进 1/16 周期</button>
            <button type="reset">重置</button>
        </div>
        <section class="physics-notes" slot="notes">
            <h2>寻找相消的线</h2>
            <p>切换双点源的振幅图。把相位差从 0° 调到 180°，比较两波源连线的中垂线。两条路径一样长时，初相位差决定两波在此处叠加还是抵消。</p>
            <p>模型是线性标量波场。点波源幅度按距离平方根的倒数近似衰减，波源附近采用有限振幅。</p>
        </section>
    </ExperimentWorkbench>
</PhysicsLayout>
