---
import PhysicsLayout from "../../../../../../components/physics/PhysicsLayout.astro";
import ExperimentWorkbench from "../../../../../../components/physics/ExperimentWorkbench.astro";
const parameters = [
    { id: "wavelength", label: "波长 λ", min: .6, max: 4, step: .1, value: 2.4, initial: "2.4 m" },
    { id: "frequency", label: "频率 f", min: .1, max: 1.5, step: .05, value: .45, initial: "0.45 Hz" },
    { id: "amplitude", label: "振幅 A", min: .15, max: 1, step: .05, value: .65, initial: "0.65 m" },
    { id: "nodes", label: "显示质点数量", min: 9, max: 65, step: 4, value: 33, initial: "33" },
    { id: "probe", label: "追踪位置", min: 0, max: 8, step: .25, value: 4, initial: "4.00 m" },
    { id: "rate", label: "播放倍率", min: .25, max: 3, step: .25, value: 1, initial: "1.00×" },
];
---
<PhysicsLayout title="横波的传播" category="waves" description="追踪绳上的一个质点。波形沿水平方向传播，质点始终停留在同一水平位置。">
    <ExperimentWorkbench canvasLabel="横波、质点和波长标记" caption="浅青色是绳的瞬时波形，橙色质点沿竖直虚线振动。顶部标尺表示一个波长。"
        parameters={parameters} measurements={[{ id: "speed", label: "物理波速 v = λf" }, { id: "period", label: "周期 T = 1/f" }, { id: "displacement", label: "追踪质点位移" }]} script="waves/shearwave/shearwave">
        <label class="physics-parameter">波形<select id="shape"><option value="sine">正弦波</option><option value="triangle">三角波</option><option value="square">方波</option></select></label>
        <div class="physics-actions">
            <button id="toggle-animation" type="button">暂停</button>
            <button id="step" type="button">步进 1/16 周期</button>
            <button type="reset">重置</button>
        </div>
        <section class="physics-notes" slot="notes">
            <h2>追踪质点与波峰</h2>
            <p>暂停后多次步进，对照同一个波峰和橙色质点。切换三角波和方波会改变质点的时间波形。方波使用理想不连续模型。</p>
            <p>播放倍率只改变观察速度。物理波速由 <code>v = λf</code> 决定。</p>
        </section>
    </ExperimentWorkbench>
</PhysicsLayout>
