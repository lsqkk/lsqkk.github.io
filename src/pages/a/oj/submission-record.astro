---
import OjLayout from "../../../layouts/OjLayout.astro";
import OjSidebar from "../../../components/OjSidebar.astro";
import { SITE_TITLE } from "@siteConfig";
---
<OjLayout title={`提交记录 - QuarkOJ - ${SITE_TITLE}`}>
  <OjSidebar active="record" />
  <main class="oj-shell">
    <div class="oj-page-heading"><h1>提交记录</h1><p>记录保存在当前浏览器。打开一条记录可以查看源码、评测结果，或回到练习台继续修改。</p></div>
    <div class="oj-card">
      <div class="oj-filters">
        <input id="oj-search" type="search" placeholder="搜索题号或标题" aria-label="搜索提交的题号或标题" />
        <select id="oj-verdict" aria-label="评测结果"><option value="">全部结果</option></select>
      </div>
      <div class="oj-list-summary" id="oj-feedback" role="status">正在加载记录…</div>
      <div id="oj-records" class="oj-feed"></div>
      <div class="oj-pagination"><button id="oj-prev" disabled>上一页</button><span id="oj-page">—</span><button id="oj-next" disabled>下一页</button></div>
    </div>
    <dialog id="oj-record-detail" class="oj-dialog">
      <div class="oj-section-head"><h2 id="oj-record-title">提交详情</h2><form method="dialog"><button>关闭</button></form></div>
      <div id="oj-record-content"></div>
    </dialog>
  </main>
  <script is:inline type="module" src="/assets/pages/a/oj/js/history.mjs"></script>
</OjLayout>
