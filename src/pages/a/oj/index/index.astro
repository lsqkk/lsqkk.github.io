---
import OjLayout from "../../../../layouts/OjLayout.astro";
import OjSidebar from "../../../../components/OjSidebar.astro";
import { SITE_TITLE } from "@siteConfig";
---
<OjLayout title={`QuarkOJ - ${SITE_TITLE}`} description="免注册的在线编程练习平台，提供专题题单、在线评测和提交记录。">
  <OjSidebar active="home" />
  <main class="oj-shell">
    <div class="oj-home-overview">
      <section class="oj-hero">
        <h1>算法练习台</h1>
        <p>按专题练习算法，在线自测与评测。</p>
        <div class="oj-actions">
          <a class="oj-button is-primary" id="oj-continue" href="/a/oj/train?p=1001">开始练习</a>
          <a class="oj-button" href="/a/oj/problem-list">浏览题库</a>
          <button id="oj-random" class="oj-quiet" disabled>随机未通过题 ↗</button>
        </div>
        <span id="oj-continue-note" class="oj-muted"></span>
      </section>
      <section class="oj-card oj-progress-card" aria-labelledby="oj-progress-title">
        <div class="oj-section-head"><h2 id="oj-progress-title">练习进度</h2><a href="/a/oj/submission-record">记录 ↗</a></div>
        <div class="oj-count"><strong id="oj-solved">—</strong><span id="oj-total">道题通过</span></div>
        <progress id="oj-progress" max="1" value="0" aria-label="题库通过进度"></progress>
        <div class="oj-metrics">
          <div><strong id="oj-attempted">—</strong><span>已尝试</span></div>
          <div><strong id="oj-submitted">—</strong><span>提交次数</span></div>
          <a href="/a/oj/problem-list?state=saved"><strong id="oj-saved">—</strong><span>已收藏 ↗</span></a>
        </div>
      </section>
    </div>
    <section class="oj-section">
      <div class="oj-section-head"><h2>专题题单</h2><a href="/a/oj/problem-list">全部题目 ↗</a></div>
      <div class="oj-track-grid" id="oj-tracks"><p class="oj-muted">正在加载题单…</p></div>
    </section>
    <section class="oj-section">
      <div class="oj-section-head"><h2>最近提交</h2><a href="/a/oj/submission-record">查看全部 ↗</a></div>
      <div class="oj-card oj-feed" id="oj-recent"></div>
    </section>
  </main>
  <script is:inline type="module" src="/assets/pages/a/oj/js/dashboard.mjs"></script>
</OjLayout>
