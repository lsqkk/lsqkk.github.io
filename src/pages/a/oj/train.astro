---
import OjLayout from "../../../layouts/OjLayout.astro";
import OjSidebar from "../../../components/OjSidebar.astro";
import { SITE_TITLE } from "@siteConfig";
---
<OjLayout title={`在线练习 - QuarkOJ - ${SITE_TITLE}`} extraStyles={["https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"]}>
  <OjSidebar active="train" />
  <main class="oj-shell oj-workbench">
    <div class="oj-workbar">
      <a href="/a/oj/problem-list">← 题库</a>
      <span id="oj-feedback" role="status">正在加载题目…</span>
      <div class="oj-actions" id="oj-problem-nav"></div>
    </div>
    <div class="oj-work-grid">
      <article class="oj-card oj-statement">
        <div class="oj-section-head"><h1 id="oj-problem-title">题面</h1><div id="oj-favorite"></div></div>
        <div class="oj-problem-meta" id="oj-meta"></div>
        <div id="oj-statement" hidden>
          <section><h2>题目描述</h2><div id="oj-description" class="oj-markdown"></div></section>
          <section><h2>输入格式</h2><div id="oj-input-format" class="oj-markdown"></div></section>
          <section><h2>输出格式</h2><div id="oj-output-format" class="oj-markdown"></div></section>
          <section>
            <div class="oj-section-head"><h2>样例</h2><button id="oj-use-sample">填入自测 ↗</button></div>
            <div class="oj-examples">
              <div><h3>输入</h3><pre id="oj-sample-input"></pre></div>
              <div><h3>输出</h3><pre id="oj-sample-output"></pre></div>
            </div>
          </section>
          <div id="oj-related" class="oj-actions"></div>
        </div>
      </article>
      <div class="oj-work-side">
        <section class="oj-card oj-editor-card">
          <div class="oj-editor-toolbar">
            <label for="oj-language">语言</label><select id="oj-language" disabled></select>
            <span id="oj-draft-status" class="oj-muted" aria-live="polite"></span>
            <button id="oj-reset-code" disabled>模板</button>
          </div>
          <textarea id="oj-code" aria-label="源代码" spellcheck="false" autocapitalize="off" autocomplete="off" disabled></textarea>
          <div class="oj-editor-footer">
            <span class="oj-muted">Ctrl/⌘ + Enter 自测</span>
            <div class="oj-actions"><button id="oj-run" disabled>运行自测</button><button id="oj-submit" class="is-primary" disabled>提交评测</button></div>
          </div>
        </section>
        <section class="oj-card oj-console">
          <div class="oj-section-head"><h2>自测输入</h2><button id="oj-clear-input" disabled>清空</button></div>
          <textarea id="oj-stdin" aria-label="自测标准输入" rows="3" spellcheck="false" placeholder="填入样例或输入自己的数据"></textarea>
          <div class="oj-section-head oj-console-head"><h2>运行结果</h2><button id="oj-cancel" hidden>停止等待</button></div>
          <p id="oj-run-status" role="status" class="oj-muted">运行样例或提交评测后，结果将在这里显示。</p>
          <div id="oj-run-results"></div>
        </section>
        <p class="oj-fineprint">代码由 Judge0 执行。题库用例公开，草稿和提交记录保存在此浏览器。</p>
      </div>
    </div>
    <dialog id="oj-template-dialog" class="oj-dialog">
      <h2>恢复语言模板？</h2><p>当前语言的草稿将被模板替换。</p>
      <form method="dialog" class="oj-actions"><button value="cancel">取消</button><button value="reset" class="is-primary">恢复模板</button></form>
    </dialog>
  </main>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js"></script>
  <script is:inline defer src="/assets/js/safe-markdown.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <script is:inline type="module" src="/assets/pages/a/oj/js/train.mjs"></script>
</OjLayout>
