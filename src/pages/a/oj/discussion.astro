---
import OjLayout from "../../../layouts/OjLayout.astro";
import OjSidebar from "../../../components/OjSidebar.astro";
import { SITE_TITLE } from "@siteConfig";
import CommentIdentityFields from "../../../components/CommentIdentityFields.astro";
---
<OjLayout
  title={`讨论区 - Quark OJ - ${SITE_TITLE}`}
  extraStyles={[
    "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css",
    "/assets/pages/a/oj/discussion.css",
  ]}
  extraHeadScripts={[
    "https://unpkg.com/marked@4.0.0/marked.min.js",
    "/assets/js/firebase-shim.js",
  ]}
>
  <OjSidebar active="discussion" />
  <main class="oj-shell">
      <div class="oj-page-heading"><h1>讨论区</h1><p>交流解题思路、定位错误，或给题面和用例提建议。</p></div>
      <div id="listView" class="view active">
        <details id="newDiscussionForm" class="new-post-form oj-card">
          <summary>发起新讨论</summary>

          <CommentIdentityFields variant="oj" />

          <div class="form-compact-row row-title-id">
            <div class="form-group problem-id-group">
              <label for="newDiscussionProblemId">题目 ID</label>
              <input type="number" id="newDiscussionProblemId" placeholder="如: 1001" value="1001" />
            </div>
            <div class="form-group discussion-title-group">
              <label for="newDiscussionTitle">讨论主题</label>
              <input type="text" id="newDiscussionTitle" placeholder="请输入主题" />
            </div>
          </div>

          <div class="form-group">
            <label for="newDiscussionContent">内容 (Markdown)</label>
            <textarea id="newDiscussionContent" rows="4" placeholder="支持 Markdown 格式..."></textarea>
          </div>

          <div class="form-submit-row">
            <button class="submit-btn" onclick="submitNewDiscussion()">发布讨论</button>
          </div>
        </details>

        <section class="discussions-list-section">
          <div class="oj-section-head">
            <h2>讨论帖</h2>
            <form class="oj-actions" id="discussionSearch">
              <input type="search" id="discussionSearchInput" placeholder="搜索题号、主题或作者" aria-label="搜索讨论" />
              <button>搜索</button>
            </form>
          </div>
          <div class="discussions-container" id="discussionsContainer"></div>
          <div class="pagination" id="pagination"></div>
        </section>
      </div>

      <div id="detailView" class="view" style="display:none;">
        <button class="back-to-list-btn" onclick="showListView()">
          <i class="fas fa-arrow-left"></i> 返回讨论列表
        </button>
        <div id="singleDiscussionContent" class="discussion-detail-card"></div>
      </div>
      <details class="oj-section">
        <summary>管理员</summary>
        <div class="oj-actions" id="admin-login-area">
          <input type="password" id="adminPassword" placeholder="管理员密码" aria-label="管理员密码" />
          <button type="button" onclick="adminLogin()">登录</button>
        </div>
      </details>
  </main>

  <script is:inline src="/assets/js/safe-markdown.js"></script>
  <script is:inline src="/assets/js/user-profile.js"></script>
  <script is:inline src="/assets/js/comment-shared.js"></script>
  <script is:inline src="/assets/js/comment-input-shared.js"></script>
  <script is:inline src="/assets/js/comment-list-shared.js"></script>
  <script is:inline src="/assets/js/comment-render-shared.js"></script>
  <script is:inline src="/assets/pages/a/oj/js/discussion.js"></script>
</OjLayout>
