---
import OjLayout from "../../../layouts/OjLayout.astro";
import OjSidebar from "../../../components/OjSidebar.astro";
import { SITE_TITLE } from "@siteConfig";
---
<OjLayout title={`题库 - QuarkOJ - ${SITE_TITLE}`}>
  <OjSidebar active="list" />
  <main class="oj-shell">
    <div class="oj-page-heading"><h1>题库</h1><p>按专题、难度或练习状态选题。</p></div>
    <div class="oj-card">
      <div class="oj-filters">
        <input type="search" id="oj-search" placeholder="搜索题号或标题" aria-label="搜索题号或标题" />
        <select id="oj-topic" aria-label="专题"><option value="">全部专题</option></select>
        <select id="oj-difficulty" aria-label="难度"><option value="">全部难度</option></select>
        <select id="oj-state" aria-label="练习状态">
          <option value="">全部状态</option><option value="unsolved">未通过</option>
          <option value="untouched">未尝试</option><option value="solved">已通过</option><option value="saved">已收藏</option>
        </select>
        <button id="oj-clear" type="button">清空筛选</button>
      </div>
      <div class="oj-list-summary"><span id="oj-feedback" role="status">正在加载题库…</span><button id="oj-random" disabled>当前筛选中随机跳题</button></div>
      <div class="oj-table-scroll">
        <table class="oj-table"><thead><tr><th scope="col">题目</th><th scope="col">难度</th><th scope="col">状态</th><th scope="col">收藏</th></tr></thead>
          <tbody id="oj-problems"></tbody>
        </table>
      </div>
      <div class="oj-pagination">
        <button id="oj-prev" disabled>上一页</button><span id="oj-page">—</span><button id="oj-next" disabled>下一页</button>
        <select id="oj-size" aria-label="每页题数"><option value="20">20 题 / 页</option><option value="40">40 题 / 页</option><option value="80">80 题 / 页</option></select>
      </div>
    </div>
  </main>
  <script is:inline type="module" src="/assets/pages/a/oj/js/catalog.mjs"></script>
</OjLayout>
