---
import { SITE_LOGO_URL, SITE_TITLE, SITE_URL } from "@siteConfig";
import "../../../../components/live/room.css";

const mediaOrigin = "https://live.130923.xyz";
const canonical = new URL("/a/live/", mediaOrigin).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101216" />
    <meta name="description" content="蓝色奇夸克的个人直播间。开播时打开网页即可观看，也可以在聊天室打个招呼。" />
    <link rel="icon" href={SITE_LOGO_URL} />
    <link rel="canonical" href={canonical} />
    <title>夸克直播间 · {SITE_TITLE}</title>
  </head>
  <body>
    <div class="broadcast" data-media-origin={mediaOrigin}>
      <header class="masthead">
        <a class="home-link" href={SITE_URL} aria-label="奇夸克首页">
          <img src={SITE_LOGO_URL} width="28" height="28" alt="" />
          <span>奇夸克</span>
        </a>
        <span class="masthead-label">直播间</span>
        <button class="button share" type="button" data-share>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 13a4 4 0 0 0 6 .4l3-3a4 4 0 0 0-5.7-5.7L11.5 6.5m2.5 4.5a4 4 0 0 0-6-.4l-3 3a4 4 0 0 0 5.7 5.7l1.8-1.8" stroke-linecap="round" /></svg>
          <span>分享直播间</span>
        </button>
      </header>

      <main class="room">
        <div class="room-heading">
          <div>
            <p class="channel-label"><span></span> QUARK LIVE</p>
            <h1>夸克直播间</h1>
          </div>
          <div class="room-state">
            <span class="elapsed" data-elapsed hidden></span>
            <span class="badge" data-status role="status">正在连接</span>
          </div>
        </div>

        <div class="room-grid">
          <section class="screen" aria-label="直播画面">
            <div class="stage">
              <video data-video controls playsinline preload="auto" aria-label="夸克直播播放器" hidden></video>
              <div class="standby" data-standby>
                <svg class="orbit" viewBox="0 0 800 460" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
                  <defs>
                    <pattern id="standby-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" stroke="#53698e" stroke-opacity=".17" /></pattern>
                    <radialGradient id="standby-glow"><stop stop-color="#273f7c" stop-opacity=".72" /><stop offset="1" stop-color="#101622" stop-opacity="0" /></radialGradient>
                    <linearGradient id="standby-orbit"><stop stop-color="#839bff" stop-opacity=".64" /><stop offset="1" stop-color="#586cc4" stop-opacity=".07" /></linearGradient>
                  </defs>
                  <path d="M0 0h800v460H0z" fill="url(#standby-grid)" />
                  <ellipse cx="400" cy="209" rx="404" ry="270" fill="url(#standby-glow)" />
                  <g transform="rotate(-24 400 218)" stroke="url(#standby-orbit)">
                    <ellipse cx="400" cy="218" rx="190" ry="105" /><ellipse cx="400" cy="218" rx="265" ry="147" /><ellipse cx="400" cy="218" rx="343" ry="191" />
                    <circle cx="665" cy="218" r="4.5" fill="#a6b8ff" stroke="none" /><circle cx="214" cy="239" r="3.5" fill="#f59c80" stroke="none" />
                  </g>
                </svg>
                <div class="standby-content">
                  <div class="signal-icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="24" cy="24" r="3" fill="currentColor" stroke="none" /><path d="M17 17a10 10 0 0 0 0 14m14-14a10 10 0 0 1 0 14M11 11a18.5 18.5 0 0 0 0 26m26-26a18.5 18.5 0 0 1 0 26" /></svg>
                  </div>
                  <h2 data-standby-title>正在连接直播间</h2>
                  <p data-standby-text>正在检查直播状态。</p>
                  <button class="button primary" type="button" data-retry hidden>重试连接</button>
                </div>
              </div>
              <button class="button play" type="button" data-play hidden>点击播放</button>
            </div>
            <div class="screen-footer">
              <span class="stream-note" data-player-note>正在检查直播状态</span>
              <button class="button edge" type="button" data-edge hidden>回到直播</button>
            </div>
          </section>

          <aside class="chat" id="chat" aria-labelledby="chat-title">
            <div class="chat-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 11.5a7.8 7.8 0 0 1-8 7.5c-1 0-1.9-.2-2.7-.4L5 20l1.4-3.9a7.1 7.1 0 0 1-1.9-4.6 7.8 7.8 0 0 1 8-7.5 7.8 7.8 0 0 1 8 7.5Z" stroke-linejoin="round" /><path d="M9 11.5h7" stroke-linecap="round" /></svg>
              <h2 id="chat-title">聊天室</h2>
              <span class="chat-state" data-chat-state>连接中</span>
            </div>
            <div class="chat-feed" data-feed tabindex="0" aria-label="聊天消息">
              <div class="chat-empty" data-chat-empty>
                <strong>这里还很安静</strong>
                <p data-chat-empty-note>开播后可以在这里打个招呼。</p>
              </div>
              <ol class="messages" data-messages aria-live="polite" aria-relevant="additions"></ol>
            </div>
            <form class="chat-form" data-chat-form>
              <label class="name-row">昵称 <input name="nickname" maxlength="20" placeholder="访客" disabled /></label>
              <div class="compose">
                <input name="message" aria-label="聊天消息" maxlength="200" placeholder="等开播后再聊" autocomplete="off" disabled />
                <button class="button primary" type="submit" disabled>发送</button>
              </div>
              <p class="form-note" data-chat-note role="status"></p>
            </form>
          </aside>
        </div>

        <footer class="room-footer">
          <span>蓝色奇夸克的个人直播间</span>
          <a href="/a/live/streamer">主播设置</a>
        </footer>
        <p class="sr-only" data-share-status role="status"></p>
      </main>
    </div>
    <script>
      import "../../../../components/live/room.js";
    </script>
  </body>
</html>
