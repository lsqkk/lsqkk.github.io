---
import { SITE_TITLE, SITE_LOGO_URL } from '@siteConfig';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="和 QuarkBot 聊聊，继续或管理从奇夸克各个页面发起的对话。" />
    <title>QuarkBot 会话 - {SITE_TITLE}</title>
    <link rel="icon" href={SITE_LOGO_URL} />
    <link rel="stylesheet" href="/assets/css/tokens.css" />
    <link rel="stylesheet" href="/assets/css/quarkbot-workspace.css" />
  </head>
  <body class="quark-bot-page">
    <main class="quark-bot-workspace" data-quarkbot-workspace>
      <nav class="quark-bot-page-nav" aria-label="站点">
        <a href="/a/">← 实验室</a>
        <a href="/a/qai/">QAI WebUI <span aria-hidden="true">↗</span></a>
      </nav>
      <header class="quark-bot-page-header">
        <div>
          <h1>QuarkBot</h1>
          <p>在站内随时开聊，回这里接着聊。</p>
        </div>
        <button type="button" data-new-chat>＋ 新建对话</button>
      </header>
      <div class="quark-bot-layout">
        <details class="quark-bot-library" open>
          <summary>对话记录</summary>
          <div class="quark-bot-library-inner">
            <input type="search" data-chat-filter aria-label="查找对话" placeholder="查找标题或原页面" />
            <ul data-chat-list aria-label="对话列表"></ul>
            <p>记录保存在此浏览器。</p>
          </div>
        </details>
        <section data-chat class="quark-bot-chat quark-bot-page-chat" aria-label="QuarkBot 对话">
          <p class="quark-bot-loading">正在打开会话…</p>
          <noscript>请启用 JavaScript 后使用 QuarkBot。</noscript>
        </section>
      </div>
      <p class="quark-bot-webui-note">想调整模型参数、管理预设或使用附件？<a href="/a/qai/">打开 QAI WebUI ↗</a></p>
    </main>
  </body>
</html>
