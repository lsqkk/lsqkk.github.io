---
interface Props {
  pageTitle: string;
  bodyClass?: string;
  pageStyles?: string[];
  headScripts?: string[];
  tailScripts?: string[];
  includeCursor?: boolean;
}

const {
  pageTitle,
  bodyClass = "dark-mode",
  pageStyles = [],
  headScripts = [],
  tailScripts = [],
  includeCursor = false,
} = Astro.props as Props;
import { SITE_LOGO_URL } from "@siteConfig";
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/assets/css/basic.css" />
    <link rel="stylesheet" href="/assets/css/fa-local.css" />
    <link rel="icon" href={SITE_LOGO_URL} type="image/png" />
    {includeCursor ? <link rel="stylesheet" href="/assets/css/cursor.css" /> : null}
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <link rel="stylesheet" href="/assets/css/room-refresh.css" />
    {headScripts.map((src) => <script is:inline src={src}></script>)}
    {includeCursor ? <script is:inline src="/assets/js/cursor-trail.js"></script> : null}
  </head>
  <body class={"room-page " + bodyClass}>
    <slot />
    {tailScripts.map((src) => <script is:inline src={src}></script>)}
  </body>
</html>
